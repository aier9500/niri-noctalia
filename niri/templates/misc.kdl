// Personal: fcitx Xmodifier

screenshot-path "~/Pictures/Screenshots/Screenshot From %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// Niri's native Alt-Tab turned off so Alt+Tab / Mod+Tab reach the binds in binds.kdl
recent-windows {
    off
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    NIXOS_OZONE_WL "1"
    XMODIFIERS "@im=fcitx"  // XWayland apps reach fcitx5 via XIM; native apps use text-input-v3
}